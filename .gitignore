# Artefacts generes par l'app (sortie de downloadMesh, etc.)
temp.json
*.tmp

# Artefacts de build regenerables (scripts/build-portable.mjs — Option A de
# PORTABILITE.md) : produit par `node scripts/build-portable.mjs` (défaut) ou
# `node scripts/build-portable.mjs --out dist/` — toujours reconstruisibles
# depuis les sources.
meshes-portable.html
dist/

# Cache Python (le projet a test_server.py et autres .py)
__pycache__/
*.pyc
.agents/

# Outillage dev (playwright-core pour les smoke tests) — l'app reste
# zero-dependency, node_modules ne sert qu'aux scripts de test locaux.
node_modules/

# VS Code (config locale par-developpeur -- ne pas tracker dans le repo)
.vscode/
