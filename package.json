    "build:portable": "node scripts/build-portable.mjs",
    "check:portable": "node scripts/check-portable.mjs",
    "check:artifact": "node scripts/check-artifact.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.49.1"
  }
